# Used by goreleaser (dockers_v2): binaries are prebuilt per platform.
FROM gcr.io/distroless/static:nonroot
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/nomctl-relay /nomctl-relay
USER 65532:65532
VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD ["/nomctl-relay", "-healthcheck"]
ENTRYPOINT ["/nomctl-relay"]
